# ===================================================
# NyayaGuide AI — Environment Configuration
# ===================================================

# Hugging Face Access Token (Read permission required for private dataset)
# Repository: charantejarangi123/govt_documents_rag_project
HF_TOKEN=your_huggingface_read_token_here

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Optional: Retrieval Relevance Threshold (default: 0.50)
MIN_RELEVANCE_THRESHOLD=0.50

# Optional: CORS Allowed Origins (comma-separated, default: localhost dev servers)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Maximum question length in characters (default: 2000)
MAX_QUESTION_LENGTH=2000

# Administrative Knowledge Base Management Secret Key (X-Admin-Key header)
ADMIN_API_KEY=your_secure_admin_key_here

